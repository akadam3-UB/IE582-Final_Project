<?xml version="1.0" ?>
<sdf version="1.10">
  <world name="bell_hall_fourth_floor">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>

    <gravity>0 0 -9.8</gravity>

    <scene>
      <ambient>0.72 0.72 0.72 1</ambient>
      <background>0.84 0.88 0.92 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>3 -42 42 1.05 0 0</pose>
      </camera>
    </gui>

    <light name="sun" type="directional">
      <pose>0 0 20 0 0 0</pose>
      <diffuse>1.0 1.0 0.95 1</diffuse>
      <specular>0.25 0.25 0.22 1</specular>
      <direction>-0.4 0.25 -1</direction>
    </light>

    <light name="north_hall_light" type="point">
      <pose>0 6.0 2.6 0 0 0</pose>
      <diffuse>0.9 0.86 0.74 1</diffuse>
      <specular>0.12 0.12 0.1 1</specular>
      <attenuation><range>20</range><constant>0.55</constant><linear>0.045</linear><quadratic>0.01</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light name="south_hall_light" type="point">
      <pose>0 -9.0 2.6 0 0 0</pose>
      <diffuse>0.9 0.86 0.74 1</diffuse>
      <specular>0.12 0.12 0.1 1</specular>
      <attenuation><range>22</range><constant>0.55</constant><linear>0.045</linear><quadratic>0.01</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <light name="east_hall_light" type="point">
      <pose>20 1.5 2.6 0 0 0</pose>
      <diffuse>0.9 0.86 0.74 1</diffuse>
      <specular>0.12 0.12 0.1 1</specular>
      <attenuation><range>16</range><constant>0.55</constant><linear>0.045</linear><quadratic>0.01</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Approximate 4th-floor footprint traced from the Autodesk Viewer PDF screenshot.
