<?xml version="1.0"?>

<window>
  <position_x>-1</position_x>
  <position_y>-1</position_y>
  <width>1480</width>
  <height>980</height>
  <style material_theme="Light" material_primary="#b85c38" material_accent="#1a6f8f"/>
  <menus>
    <drawer visible="true" default="false"/>
    <plugins visible="true" from_paths="true"/>
  </menus>
</window>

<plugin filename="MinimalScene" name="3D View">
  <gz-gui>
    <title>Room 427 View</title>
    <property key="state" type="string">docked</property>
    <property key="showTitleBar" type="bool">true</property>
  </gz-gui>
  <engine>ogre2</engine>
  <scene>scene</scene>
  <ambient_light>0.7 0.7 0.7</ambient_light>
  <background_color>0.92 0.94 0.98</background_color>
  <camera_pose>11.5 -10.5 8.5 0 0.7 1.08</camera_pose>
</plugin>

<plugin filename="ImageDisplay" name="PanTilt Camera">
  <topic>/world/room_427_tracking_test/model/pantilt/link/tilt_link/sensor/camera/image</topic>
  <gz-gui>
    <title>PanTilt Camera Feed</title>
    <property key="state" type="string">docked</property>
    <property key="showTitleBar" type="bool">true</property>
    <property key="width" type="double">540</property>
    <property key="height" type="double">420</property>
  </gz-gui>
</plugin>

<plugin filename="WorldControl" name="World control">
  <gz-gui>
    <property key="state" type="string">floating</property>
  </gz-gui>
  <play_pause>true</play_pause>
  <step>true</step>
  <start_paused>false</start_paused>
</plugin>
