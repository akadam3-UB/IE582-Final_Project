<?xml version="1.0"?>
<snippets>
  <!-- Copy one actor block into a world before </world>. Edit every waypoint pose to place it.
       Actors animate only when Gazebo is playing. Start with `gz sim -r ...` or press Play. -->

  <actor name="moving_person_talking_1">
    <skin>
      <filename>model://actor_colored/meshes/talk_b_red.dae</filename>
      <scale>1.0</scale>
    </skin>
    <animation name="talk_b">
      <filename>model://actor_colored/meshes/talk_b_red.dae</filename>
      <scale>0.055</scale>
      <interpolate_x>true</interpolate_x>
    </animation>
    <script>
      <loop>true</loop>
      <auto_start>true</auto_start>
      <trajectory id="0" type="talk_b">
          <waypoint><time>0</time><pose>8.6 5.05 1.02 0 0 -0.45</pose></waypoint>
          <waypoint><time>4</time><pose>8.6 5.05 1.02 0 0 -0.10</pose></waypoint>
          <waypoint><time>8</time><pose>8.6 5.05 1.02 0 0 -0.60</pose></waypoint>
          <waypoint><time>12</time><pose>8.6 5.05 1.02 0 0 -0.35</pose></waypoint>
        </trajectory>
    </script>
  </actor>

