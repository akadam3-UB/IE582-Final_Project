  <actor name="moving_person_walking_1">
    <skin>
      <filename>model://actor_colored/meshes/walk_blue.dae</filename>
      <scale>1.0</scale>
    </skin>
    <animation name="walk">
      <filename>model://actor_colored/meshes/walk_blue.dae</filename>
      <interpolate_x>true</interpolate_x>
    </animation>
    <script>
      <loop>true</loop>
      <auto_start>true</auto_start>
      <trajectory id="0" type="walk" tension="0.3">
        <waypoint><time>0</time><pose>8.15 1.45 1.02 0 0 0.00</pose></waypoint>
        <waypoint><time>4</time><pose>10.00 1.45 1.02 0 0 1.57</pose></waypoint>
        <waypoint><time>8</time><pose>10.00 2.25 1.02 0 0 3.14</pose></waypoint>
        <waypoint><time>12</time><pose>8.15 2.25 1.02 0 0 -1.57</pose></waypoint>
        <waypoint><time>16</time><pose>8.15 1.45 1.02 0 0 0.00</pose></waypoint>
      </trajectory>
    </script>
  </actor>

